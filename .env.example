# Banco e autenticação (Supabase local)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=coloque-a-anon-key-do-supabase-status
SUPABASE_SERVICE_ROLE_KEY=coloque-a-service-role-key-do-supabase-status

# Cliente (Vite) — apenas variáveis públicas entram no bundle
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=coloque-a-anon-key-do-supabase-status
VITE_API_URL=http://localhost:3002

# API
API_PORT=3002
# Origem pública do app (React + Vite). A API só aceita CORS dessa origem.
APP_URL=http://localhost:5173
# Use true somente atrás de um proxy reverso confiável: o limite de requisições passa a usar
# o primeiro IP de X-Forwarded-For. Com false (padrão) o cabeçalho é ignorado.
TRUST_PROXY=false
# Segredo HS256 dos tokens de sessao (minimo de 32 caracteres; so servidor, nunca com prefixo VITE_).
# A API nao sobe sem ele. Gere um valor proprio, por exemplo:
#   node -p "require('node:crypto').randomBytes(48).toString('base64')"
AUTH_JWT_SECRET=troque-por-um-segredo-aleatorio

# OpenTelemetry (OTLP HTTP do collector local)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=rondo-api
OTEL_EXPORTER_OTLP_TIMEOUT=3000

# E-mail transacional (só servidor; nunca com prefixo VITE_)
# mailtrap = fora de produção (a mensagem fica na caixa do Mailtrap), resend = produção,
# capture = testes automatizados (guarda em memória; a API não sobe com capture em produção).
EMAIL_PROVIDER=mailtrap
EMAIL_FROM=Rondo <no-reply@rondo.local>
# Mailtrap Email Sandbox: token de API e id numérico da caixa (Settings da inbox)
MAILTRAP_API_TOKEN=coloque-o-token-de-api-do-mailtrap
MAILTRAP_INBOX_ID=coloque-o-id-da-caixa-do-mailtrap
# Resend (produção): chave de API e remetente de um domínio verificado em EMAIL_FROM
RESEND_API_KEY=coloque-a-chave-de-api-do-resend
